# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  LEAD ADMIN — Environment Variables                                    ║
# ║                                                                        ║
# ║  Copy file này thành .env (dev) hoặc .env.production (production)      ║
# ║  và điền giá trị thật.                                                 ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Database ──────────────────────────────────────────────────────────────
# Prisma reads from .env (not .env.local)
DATABASE_URL="postgresql://postgres:123456@localhost:5432/lead_admin?schema=public"

# ── Security (BẮT BUỘC) ──────────────────────────────────────────────────
# Auth secret để ký JWT token. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING"

# Cron secret để bảo vệ các endpoint cleanup/export
CRON_SECRET="CHANGE_ME_TO_RANDOM_32_CHAR_HEX_STRING"

# ── RetailCRM Integration ────────────────────────────────────────────────
RETAILCRM_BASE_URL="https://uzshopping.retailcrm.ru/api/v5"
RETAILCRM_API_KEY="YOUR_RETAILCRM_API_KEY"
RETAILCRM_SITE="uzshopping"

# ── Auto-Cleanup Cron ────────────────────────────────────────────────────
# Giờ chạy cleanup mỗi ngày (0-23). Mặc định: 23 (11 giờ tối)
CLEANUP_CRON_HOUR=23
# Để test nhanh: set số phút thay vì chờ cuối ngày
# CLEANUP_INTERVAL_MINUTES=5

# ── Google Sheets Auto-Export ────────────────────────────────────────────
GOOGLE_APPS_SCRIPT_URL="YOUR_GOOGLE_APPS_SCRIPT_URL"
# Must match EXPORT_SECRET in Google Apps Script > Script Properties.
GOOGLE_APPS_SCRIPT_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
# Year/month routing uses order creation time in this timezone.
SHEETS_EXPORT_TIMEZONE="Asia/Bangkok"
# Stable namespace; use different values for separate apps/databases sharing an archive.
GOOGLE_SHEETS_SOURCE="lead-admin"
# Chu kỳ xuất: tháng chẵn
# SHEETS_EXPORT_MONTHS=2,4,6,8,10,12
# Test mode:
# SHEETS_EXPORT_INTERVAL_MINUTES=5

# ── Order ID Prefix ──────────────────────────────────────────────────────
# Local: ORD- (default), Production: LDP-
ORDER_PREFIX=ORD-

# ── Cookie Security ──────────────────────────────────────────────────────
# Public API origin used for webhook URLs. Set before npm run build.
NEXT_PUBLIC_API_BASE_URL="https://api.bigboxfulfillment.vn"

# Set FORCE_HTTP=true khi chưa có SSL (IP trực tiếp, chưa có domain)
# Bỏ biến này khi đã có domain + HTTPS
# FORCE_HTTP=true

# ══════════════════════════════════════════════════════════════════════════
# HƯỚNG DẪN DEPLOY
# ══════════════════════════════════════════════════════════════════════════
#
# --- Kịch bản 1: Production IP (chưa có domain, chưa có SSL) ---
# 1. Copy file này thành .env.production
# 2. Điền giá trị thật
# 3. Thêm: FORCE_HTTP=true
# 4. Thêm: ORDER_PREFIX=LDP-
# 5. Chạy: pm2 start ecosystem.config.cjs --env production
#
# --- Kịch bản 2: Production có domain + SSL ---
# 1. Copy file này thành .env.production
# 2. Điền giá trị thật
# 3. KHÔNG thêm FORCE_HTTP (mặc định secure = true)
# 4. Thêm: ORDER_PREFIX=LDP-
# 5. Cấu hình nginx reverse proxy
# 6. Chạy: pm2 start ecosystem.config.cjs --env production

# RetailCRM inbound status webhook; >=32 chars. Keep private, never NEXT_PUBLIC.
RETAILCRM_WEBHOOK_SECRET=""

# Site used to read current order status from RetailCRM
RETAILCRM_STATUS_SITE="bigbox"

# Stocker Partner API (server-only)
STOCKER_BASE_URL="https://partner.stocker.uz"
# Tạo khóa bằng: node -p "require('node:crypto').randomBytes(32).toString('hex')"
# Giữ khóa ổn định để giải mã tài khoản đã lưu trong database.
STOCKER_CREDENTIALS_KEY=""
